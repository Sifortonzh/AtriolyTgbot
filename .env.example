# ============================================================
# Atrioly · Wanatring Environment Example
# Copy this file to `.env` and fill in your real values.
# Never commit your real `.env` file.
# ============================================================

# ------------------------------------------------------------
# Credentials
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# Universal fallback key. Optional.
# If a provider-specific key is empty, the bot may use AI_API_KEY instead.
AI_API_KEY=

# OpenAI
OPENAI_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# Anthropic / Claude
ANTHROPIC_API_KEY=

# Generic OpenAI-compatible provider
OPENAI_COMPATIBLE_API_KEY=

# ------------------------------------------------------------
# AI Provider Router
# Supported providers: openai, deepseek, anthropic, openai_compatible
# `.env` defines the default provider at startup.
# Owner Telegram inline button can create runtime override in `/app/data/ai_runtime.json`.
# Use "Clear Runtime Override" in Telegram to return to `.env` defaults.
# ------------------------------------------------------------
AI_PROVIDER=openai
AI_PROVIDER_FALLBACKS=openai,deepseek

# Recommended quality setup
# Use gpt-4o for better judgment quality and more stable radar output.
DEFAULT_MODEL=gpt-4o
RADAR_MODEL=gpt-4o
PRIVATE_MODEL=gpt-4o
TASK_MODEL=gpt-4o
CHAT_MODEL=gpt-4o
VISION_MODEL=gpt-4o
AI_VISION_MODEL=

# ------------------------------------------------------------
# Provider endpoints / provider-specific models
# ------------------------------------------------------------
AI_BASE_URL=
OPENAI_BASE_URL=

DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

ANTHROPIC_MODEL=claude-3-5-haiku-latest

OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

# ------------------------------------------------------------
# AI Runtime
# ------------------------------------------------------------
MAX_MESSAGE_LENGTH=1200
AI_REQUEST_TIMEOUT_SECONDS=30
AI_RETRY_TIMES=2
AI_PROVIDER_RETRY_TIMES=1
AI_FAILOVER_FAST_ON_NETWORK_ERROR=true
AI_TEMPERATURE=0.2
AI_CACHE_TTL_SECONDS=300

# ------------------------------------------------------------
# Access Control & Forwarding
# Telegram numeric IDs only. Comma-separated values are supported.
# Example: OWNER_IDS=123456789,987654321
# ------------------------------------------------------------
OWNER_IDS=123456789
FORWARD_TO=123456789
ADMIN_ONLY_AI_TEST=true

# ------------------------------------------------------------
# Feature Flags
# ------------------------------------------------------------
ENABLE_AUTO_BAN=true
ENABLE_DAILY_REPORT=false
ENABLE_SENDER_PROFILE_LINK=true
ENABLE_AI_FILTER=true
ENABLE_HEURISTIC_FILTER=true

# ------------------------------------------------------------
# Data Paths
# For Docker deployment, keep DATA_DIR as /app/data.
# For local development, you may use ./data.
# ------------------------------------------------------------
DATA_DIR=/app/data
BLACKLIST_DB_FILE=blacklist.json
MEMBERSHIP_DB_FILE=memberships.json
STATE_DB_FILE=state.json

# ------------------------------------------------------------
# Logging
# Allowed values: DEBUG, INFO, WARNING, ERROR, CRITICAL
# ------------------------------------------------------------
LOG_LEVEL=INFO
LOG_AI_RESULT=true
LOG_FORWARD_ACTIONS=true
LOG_MODERATION_ACTIONS=true

# ------------------------------------------------------------
# Time & Schedule
# ------------------------------------------------------------
DEFAULT_TIMEZONE=Asia/Shanghai
DAILY_REPORT_TIME=22:30
WEEKLY_REPORT_DAY=SUN
WEEKLY_REPORT_TIME=22:45

# ------------------------------------------------------------
# Moderation
# ------------------------------------------------------------
MAX_STRIKES=3
WARNING_EXPIRE_DAYS=30
MIN_TEXT_LENGTH_FOR_AI=5

# ------------------------------------------------------------
# Radar
# ------------------------------------------------------------
RADAR_RECENT_HOURS=24
MIN_CONFIDENCE_TO_FORWARD=0.65
HIGH_RISK_THRESHOLD=75
